--- /dev/null
+++ b/python/sglang/srt/model_executor/prefill_cuda_graph.py
@@ -0,0 +1,121 @@
+# Copyright 2023-2026 SGLang Team
+# Licensed under the Apache License, Version 2.0 (the "License");
+"""Stable construction and diagnostics for the breakable prefill graph engine."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Optional
+
+import torch
+
+
+@dataclass(frozen=True)
+class PrefillCudaGraphDiagnostics:
+    """Detached snapshot of observable engine state."""
+
+    backend: str
+    capture_active: bool
+    graph_count: int = 0
+    segment_count: int = 0
+    eager_break_count: int = 0
+    replay_count: int = 0
+    allocation_identity: Optional[int] = None
+    allocation_capacity: int = 0
+
+
+class PrefillCudaGraphFactory:
+    """Canonical constructor for the explicit breakable prefill engine."""
+
+    @staticmethod
+    def shape_identity(
+        size: int,
+        stream_idx: Optional[int] = None,
+        variant_label: Optional[str] = None,
+    ) -> Any:
+        from sglang.srt.model_executor.breakable_cuda_graph_runner import ShapeKey
+
+        return ShapeKey(size, stream_idx, variant_label)
+
+    @classmethod
+    def create(cls, model_runner: Any) -> Any:
+        from sglang.srt.model_executor.breakable_cuda_graph_runner import (
+            BreakableCudaGraphRunner,
+        )
+
+        runner = BreakableCudaGraphRunner(model_runner)
+        runner._prefill_cuda_graph_replay_count = 0
+        return runner
+
+
+def _first_tensor(value: Any) -> Optional[torch.Tensor]:
+    if torch.is_tensor(value):
+        return value
+    if isinstance(value, dict):
+        values = value.values()
+    elif isinstance(value, (tuple, list)):
+        values = value
+    elif hasattr(value, "tensors") and isinstance(value.tensors, dict):
+        values = value.tensors.values()
+    else:
+        return None
+    for item in values:
+        tensor = _first_tensor(item)
+        if tensor is not None:
+            return tensor
+    return None
+
+
+def get_prefill_cuda_graph_diagnostics(subject: Any) -> PrefillCudaGraphDiagnostics:
+    """Return an immutable snapshot for a production model or graph runner."""
+
+    graph_runner = getattr(subject, "piecewise_cuda_graph_runner", None)
+    if graph_runner is not None and graph_runner is not subject:
+        return get_prefill_cuda_graph_diagnostics(graph_runner)
+
+    graphs = getattr(subject, "graphs", None)
+    if graphs is None and hasattr(subject, "_segments"):
+        graph_values = [subject]
+    elif isinstance(graphs, dict):
+        graph_values = list(graphs.values())
+    else:
+        graph_values = []
+
+    segment_count = sum(len(getattr(graph, "_segments", ())) for graph in graph_values)
+    eager_break_count = sum(
+        len(getattr(graph, "_break_fns", ())) for graph in graph_values
+    )
+    shared = _first_tensor(getattr(subject, "shared_output_buffer", None))
+    if shared is None:
+        allocation_identity = None
+        allocation_capacity = 0
+    else:
+        storage = shared.untyped_storage()
+        allocation_identity = storage.data_ptr()
+        allocation_capacity = storage.nbytes()
+
+    try:
+        from sglang.srt.model_executor.breakable_cuda_graph.context import (
+            is_in_breakable_cuda_graph,
+        )
+
+        capture_active = is_in_breakable_cuda_graph()
+    except ImportError:
+        capture_active = False
+
+    return PrefillCudaGraphDiagnostics(
+        backend="breakable",
+        capture_active=capture_active,
+        graph_count=len(graph_values),
+        segment_count=segment_count,
+        eager_break_count=eager_break_count,
+        replay_count=getattr(subject, "_prefill_cuda_graph_replay_count", 0),
+        allocation_identity=allocation_identity,
+        allocation_capacity=allocation_capacity,
+    )
+
+
+def _increment_replay_diagnostic(subject: Any) -> None:
+    subject._prefill_cuda_graph_replay_count = (
+        getattr(subject, "_prefill_cuda_graph_replay_count", 0) + 1
+    )
