-    def _mamba_verify_update(
-        self,
-        batch: ScheduleBatch,
-        res: EagleVerifyOutput,
-        logits_output: LogitsProcessorOutput,
-        spec_info: EagleVerifyInput,
-        seq_lens_pre_verify: torch.Tensor,
