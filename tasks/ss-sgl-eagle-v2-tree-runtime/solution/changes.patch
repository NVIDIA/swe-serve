-            self.speculative_num_steps,
-            self.speculative_num_draft_tokens,
-        )
-
-        target_capture_mode = (
-            CaptureHiddenMode.NULL
-            if self.speculative_algorithm.is_standalone()
-            else CaptureHiddenMode.FULL
