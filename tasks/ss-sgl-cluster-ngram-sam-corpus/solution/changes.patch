+void Ngram::startExternalCorpusLoad() {
+  if (staging_sam_) {
+    throw std::runtime_error("startExternalCorpusLoad called while another load is in progress");
+  }
+  staging_sam_ = std::make_unique<SuffixAutomaton>();
