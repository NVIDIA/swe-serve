+def _compact_fused_moe_lora(
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    token_lora_ids: torch.Tensor,
+    lora_a: torch.Tensor,
+    lora_b: torch.Tensor,
+    lora_ranks: torch.Tensor,
+    num_experts: int,
+    apply_routed_weight: bool = True,
+) -> torch.Tensor:
+    """Return routed LoRA deltas under the documented public K1 contract."""
+    if hidden_states.ndim != 2 or topk_ids.ndim != 2 or topk_weights.ndim != 2:
+        raise ValueError("hidden_states, topk_ids, and topk_weights must be rank two")
+    if topk_ids.shape != topk_weights.shape or topk_ids.shape[0] != hidden_states.shape[0]:
+        raise ValueError("route tensors must agree with the token dimension")
+    if token_lora_ids.ndim != 1 or token_lora_ids.shape[0] != hidden_states.shape[0]:
+        raise ValueError("token_lora_ids must have shape [num_tokens]")
+    if lora_a.ndim != 4 or lora_b.ndim != 4:
+        raise ValueError("lora_a and lora_b must have shape [L, E|1, ..., ...]")
+    if lora_a.shape[0] != lora_b.shape[0] or lora_a.shape[0] != lora_ranks.numel():
+        raise ValueError("LoRA adapter dimensions must agree")
+    if lora_a.shape[2] != lora_b.shape[3] or lora_a.shape[3] != hidden_states.shape[1]:
+        raise ValueError("LoRA rank/input dimensions are inconsistent")
+    if not all(
+        tensor.device == hidden_states.device
+        for tensor in (topk_ids, topk_weights, token_lora_ids, lora_a, lora_b, lora_ranks)
+    ):
+        raise ValueError("all compact fused inputs must be on one device")
+
+    num_loras = lora_a.shape[0]
+    if num_experts <= 0:
+        raise ValueError("num_experts must be positive")
+    if lora_a.shape[1] not in (1, num_experts) or lora_b.shape[1] not in (1, num_experts):
+        raise ValueError("A and B expert axes must independently be shared or per-expert")
+    max_rank = lora_a.shape[2]
+    if torch.any((lora_ranks < 0) | (lora_ranks > max_rank)):
+        raise ValueError("lora_ranks must lie in [0, max_rank]")
+
+    rank_mask = (
+        torch.arange(max_rank, device=hidden_states.device)[None, None, :, None]
+        < lora_ranks.to(torch.int64)[:, None, None, None]
+    )
+    expanded_a = lora_a.expand(num_loras, num_experts, -1, -1).contiguous()
+    expanded_a = expanded_a * rank_mask.to(expanded_a.dtype)
+    expanded_b = lora_b.expand(num_loras, num_experts, -1, -1).contiguous()
+
+    sorted_route_ids, expert_ids, num_routes_post_pad = moe_lora_align_block_size(
+        topk_ids,
+        token_lora_ids,
+        16,
+        num_experts,
+        num_loras,
+    )
+    lora_ids = torch.arange(num_loras, dtype=torch.int32, device=hidden_states.device)
+    adapter_enabled = (lora_ranks > 0).to(torch.int32)
+    output = torch.zeros(
+        (*topk_ids.shape, lora_b.shape[2]),
+        dtype=hidden_states.dtype,
+        device=hidden_states.device,
+    )
+    config = (16, 32, 64, 1, 4, 3, 1)
+    _source_fused_moe_lora(
+        output,
+        hidden_states,
+        [expanded_a],
+        [expanded_b],
+        topk_weights,
+        sorted_route_ids,
+        expert_ids,
+        num_routes_post_pad,
+        max_rank,
+        topk_ids.shape[1],
+        lora_ids,
+        adapter_enabled,
+        *config,
+        *config,
+        apply_routed_weight,
+    )
+    return output
+
+
+def fused_moe_lora(*args, **kwargs):
+    """Dispatch the compact public API and preserve the upstream source ABI."""
+    compact_names = {
+        "hidden_states",
+        "topk_ids",
+        "topk_weights",
+        "token_lora_ids",
+        "lora_a",
+        "lora_b",
+        "lora_ranks",
+        "num_experts",
+        "apply_routed_weight",
+    }
+    if not args and "hidden_states" in kwargs:
+        if not set(kwargs).issubset(compact_names):
+            raise TypeError("invalid compact fused_moe_lora arguments")
+        return _compact_fused_moe_lora(**kwargs)
+    if len(args) in (8, 9):
+        return _compact_fused_moe_lora(*args)
+    return _source_fused_moe_lora(*args, **kwargs)
